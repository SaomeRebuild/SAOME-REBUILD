{
  "name": "@saome/shared",
  "version": "1.0.0",
  "description": "SAOME-REBUILD shared package - business logic, types, schemas, i18n, BDD steps",
  "type": "module",
  "main": "./index.ts",
  "types": "./index.ts",
  "exports": {
    ".": {
      "types": "./index.ts",
      "default": "./index.ts"
    },
    "./bdd": {
      "types": "./bdd/index.ts",
      "default": "./bdd/index.ts"
    },
    "./types": "./types/index.ts",
    "./schemas": "./schemas/index.ts",
    "./schemas/auth": "./schemas/auth.ts",
    "./schemas/member": "./schemas/member.ts",
    "./schemas/order": "./schemas/order.ts",
    "./schemas/pass": "./schemas/pass.ts",
    "./schemas/cardBuilder": "./schemas/cardBuilder.ts",
    "./logic": "./logic/index.ts",
    "./logic/member": "./logic/member.ts",
    "./logic/order": "./logic/order.ts",
    "./logic/pass": "./logic/pass.ts",
    "./logic/imageCrop": "./logic/imageCrop.ts",
    "./logic/auth": "./logic/auth.ts",
    "./logic/color": "./logic/color.ts",
    "./constants": "./constants/index.ts",
    "./constants/role": "./constants/role.ts",
    "./constants/card-images": "./constants/card-images.ts",
    "./constants/card-fields": "./constants/card-fields.ts",
    "./constants/crop-interaction": "./constants/crop-interaction.ts",
    "./constants/r2": "./constants/r2.ts",
    "./i18n": "./i18n/index.ts",
    "./i18n/zh-TW": "./i18n/zh-TW.ts",
    "./i18n/en": "./i18n/en.ts",
    "./i18n/detectLanguage": "./i18n/detectLanguage.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:bdd": "cucumber-js",
    "test:bdd:watch": "cucumber-js --watch",
    "build": "tsc",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^10.9.0",
    "@cucumber/pretty-formatter": "^1.0.1",
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "zod": "^3.23.0"
  },
  "keywords": [
    "saome",
    "shared",
    "bdd",
    "cucumber"
  ],
  "engines": {
    "node": ">=20.0.0"
  }
}
