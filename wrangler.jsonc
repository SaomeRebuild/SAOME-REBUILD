// SAOME Frontend Cloudflare Workers 設定
//
// Why this file is at repo root (not frontend/):
// - Cloudflare Workers conventionally looks for wrangler.jsonc at the repo root
//   when triggered by a git push from the connected GitHub repo.
// - Our frontend lives in a `frontend/` subfolder (monorepo layout), so the
//   `assets.directory` below points into that subfolder.
// - If we ever add backend/ as a separate Worker, each Worker needs its own
//   wrangler config (separate Worker = separate deploy). For now this single
//   Worker handles only the frontend assets.
{
  "name": "saome-frontend",
  "compatibility_date": "2026-07-26",
  "assets": {
    "directory": "./frontend/dist",
    "not_found_handling": "single-page-application"
  },
  "compatibility_flags": ["nodejs_compat"]
}