# Dev: use Vite proxy (same-origin) - backend at http://127.0.0.1:8787 via Vite proxy
# This avoids CORS issues and is the recommended dev setup
VITE_API_BASE_URL=
VITE_APP_BASE_URL=http://localhost:5174
# passHolderService (2026-09-29): when 'true', use the local SAMPLE_TEMPLATES
# mock instead of /api/pass-templates/:id/public. Set to 'true' only when
# the backend isn't running locally and you need to develop the UI.
# Decision: runs/decisions/2026-09-29-pass-templates-public-endpoint.md § Decision 2
VITE_USE_PASS_MOCK=false
