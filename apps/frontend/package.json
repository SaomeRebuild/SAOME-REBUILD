{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/audit-config-defaults.cjs",
    "pages:build": "tsc -b && vite build",
    "deploy": "npx wrangler deploy",
    "typecheck": "tsc -b --noEmit",
    "lint": "oxlint",
    "preview": "vite preview",
    "verify:i18n": "node scripts/verify-i18n-keys.mjs",
    "test": "node scripts/verify-i18n-keys.mjs && vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "audit:lockfile": "node scripts/audit-lockfile-bindings.cjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.5.7",
    "@saome/shared": "*",
    "@tailwindcss/vite": "^4.3.3",
    "clsx": "^2.1.1",
    "i18next": "^26.3.6",
    "lucide-react": "^1.26.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.83.0",
    "react-i18next": "^17.0.11",
    "react-resizable-panels": "^4.12.2",
    "react-router-dom": "^7.18.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "zod": "^3.25.76",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/ui": "^3.0.0",
    "jsdom": "^25.0.0",
    "oxlint": "^1.71.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.1",
    "vitest": "^3.0.0",
    "wrangler": "^4.34.0"
  }
}
