{
  "name": "backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev --port 8787 --remote",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "r2:apply-cors": "wrangler r2 bucket cors set saome --file r2-cors.json",
    "r2:list-cors": "wrangler r2 bucket cors list saome"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20",
    "hono": "^4.6.0",
    "jose": "^5.9.0",
    "postgres": "^3.4.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.0",
    "@cloudflare/workers-types": "^4.20251020.0",
    "@types/node": "^24.13.2",
    "typescript": "^7.0.2",
    "vitest": "^3.0.0",
    "wrangler": "^4.129.0"
  }
}
