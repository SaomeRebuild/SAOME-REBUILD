# Dependencies
node_modules/
.pnpm-store/

# Build artifacts
dist/
dist-ssr/
build/
.turbo/

# Wrangler / Cloudflare cache
.wrangler/

# Logs
*.log
logs/

# Legacy assets (now in frontend/public/)
pic/

# Runtime data — exclude most runtime/ephemeral outputs, but KEEP
# improvement feedback inside `runs/improvements/` as team knowledge.
runs/*
!runs/improvements/

# mu-plugins: read-only reference, never commit
mu-plugins/

# Environment files
.env
.env.local
.env.*.local

# OS files
.DS_Store
Thumbs.db

# Test coverage
coverage/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
*.sw?
*.suo

# NOTE: .cursor/ is NOT ignored — rules/ and skills/ are committed as
# team-shared documentation. Cursor IDE personal state lives under
# .cursor/agents/ and .cursor/projects/ which are blocked by .cursorignore.