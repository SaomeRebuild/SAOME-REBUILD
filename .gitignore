# Build
node_modules/
dist/
dist-ssr/
build/
*.tsbuildinfo
coverage/

# Test runner outputs (vitest, playwright)
test-results/
playwright-report/
test-outputs/
.vitest-result.json

# Lockfiles
# Root package-lock.json IS committed (required for CI `npm ci` at workspace root).
# Sub-workspace lockfiles (apps/*, packages/*) are intentionally NOT committed
# because npm 10 hoists all deps to root node_modules and only the root lockfile
# stays in sync. See .cursor/rules/015-cloudflare-pages-deploy.mdc.
apps/*/package-lock.json
packages/*/package-lock.json

# Cache / Lock-store / Logs
.turbo/
.cache/
*.log
logs/

# Wrangler / Cloudflare cache
.wrangler/
.pnpm-store/
# Wrangler tail debug outputs — never commit (runtime logs, ephemeral)
wrangler-tail*.json
wrangler-tail*.txt
# Wrangler build output — never commit (generated by `wrangler deploy`)
apps/backend/tmp/
# Wrangler-generated binding types — never commit (regenerated by `wrangler types`)
apps/backend/worker-configuration.d.ts

# Legacy assets (now in apps/frontend/public/)
pic/

# Runtime data — exclude most runtime/ephemeral outputs, but KEEP
# improvement feedback inside `runs/improvements/` as team knowledge,
# KEEP decision logs inside `runs/decisions/` (per AGENTS.md "Decision
# Log 規範 (L3 Heavy 必填)"), KEEP public articles inside
# `runs/articles/` (per skill article-writing), and KEEP the
# implementation plans inside `runs/plans/`.
#
# `runs/plans/` matters: the Decision Logs reference the plans by
# path (e.g. `runs/decisions/2026-10-24-pass-runtime-value-model.md`
# → `runs/plans/2026-10-24-pass-runtime-values-roadmap.md` +
# `runs/plans/2026-10-24-pass-scanner-event-semantics.md`). If the
# plans were ignored, those references would dangle for anyone who
# clones the repo — the plan is the record of WHY a decision was
# made, and the follow-up work that is blocked on it.
runs/*
!runs/improvements/
!runs/decisions/
!runs/articles/
!runs/plans/

# Supabase CLI local state — never commit (the CLI writes its version
# marker + project cache here; both are machine-local).
supabase/.temp/

# mu-plugins: read-only reference, never commit
mu-plugins/

# Environment files
.env
.env.local
.env.*.local

# OS files
.DS_Store
Thumbs.db

# IDE / Editor directories
.vscode/*
!.vscode/extensions.json
.idea/
*.sw?
*.suo

# Local scratch
.commit-msg-*.tmp
.git-rebase-todo
*.tmp
# Repo-root agent scratch files (for example, .tmp_inventory.json)
# NOTE: `*.tmp` above only matches names ENDING in `.tmp`, so it does NOT
# cover `.tmp_inventory.json` / `.tmp_foo.mjs`. Keep this rule: dropping it
# lets agent scratch files show up as untracked in every `git status`.
/.tmp*

# One-off agent scripts must never enter the repo (Rule 040 file write tool
# precedence). Throwaway repair/probe scripts belong in the OS temp directory
# and are deleted after use. The permanent CI gate script is the sole
# exception under scripts/.
scripts/*.cjs
!scripts/check-oneoff-scripts.cjs

# Repo-root scratch scripts and Vite alias probe leftovers
/*.tmp.mjs
/*.tmp.cjs
/vite-*-probe.*

# Debug probe artifacts — ad-hoc one-off investigation scripts/outputs
# (See runs/improvements/feedback/ for the trace that produced them)
login.json
login-resp.json
publish.json
test_output.txt
apps/backend/scripts/probe-*.ts
apps/backend/scripts/probe-*.mjs
apps/backend/scripts/probe-*.cjs

# Production data dumps — never commit (per .cursor/rules/019-schema-contract-drift.mdc
# 提到的真實污染證據;含真實 email/phone,不該 push)
tenants_rows.json
users_rows.json
*_rows.json

# NOTE: .cursor/ is NOT ignored — rules/ and skills/ are committed as
# team-shared documentation. Cursor IDE personal state lives under
# .cursor/agents/ and .cursor/projects/ which are blocked by .cursorignore.

# Private layers — owner-agent local state, never commit (per skill
# saome-self-improvement 三層決策表「私人層」)
projects/
.cursor/agents/

# NOTE: DEV/ is committed as 操作層 — 開發紀錄要備份
# (see .cursor/skills/saome-self-improvement/SKILL.md 三層決策表更新)
